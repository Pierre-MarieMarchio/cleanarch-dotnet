<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup Label="Analysis">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <ItemGroup Label="Launcher">
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup Label="Project tool">
    <!-- The 10.0.1xx band of the SDK that global.json pins. -->
    <PackageVersion Include="Microsoft.TemplateEngine.Core" Version="10.0.114" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
