<Project>

  <!-- Every version is declared here once, or in the line's file imported below; projects reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--#if (localAuth)-->
  <ItemGroup Label="Identity model">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <!--#endif-->
  <!-- The packages whose version follows .NET, on the project's line. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Packages.net10.0.props" />

  <!--#if (dotnetClient)-->
  <!-- The version the pinned Kiota tool generates for; the two move together. -->
  <ItemGroup Label="API client">
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.1.6" />
  </ItemGroup>

  <!--#endif-->
  <!--#if (presentationAvalonia)-->
  <!-- One Avalonia 12.1.x band, the version Avalonia.Templates writes. -->
  <!--#endif-->
  <!--#if (presentationAvalonia || presentationWpf)-->
  <ItemGroup Label="Desktop presentation">
  <!--#endif-->
  <!--#if (presentationAvalonia)-->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  <!--#endif-->
  <!--#if (presentationAvalonia || presentationWpf)-->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--#if (externalAuth)-->
    <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <!--#endif-->
  </ItemGroup>

  <!--#endif-->
  <!--#if (presentationMcp)-->
  <ItemGroup Label="MCP server">
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <!--#endif-->
  <!-- One 1.18.x band. -->
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <!--#if (sqlServer)-->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <!--#endif-->
  </ItemGroup>

  <!--#if (files)-->
  <!-- AWSSDK.S3 only: the client is built from the module's own validated options. -->
  <ItemGroup Label="Object storage">
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
  </ItemGroup>

  <!--#endif-->
  <ItemGroup Label="Third-party runtime">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.0.2" />
  </ItemGroup>

  <!--#if (aspire)-->
  <!-- One band with the app host's SDK in global.json, which LocalStackParityTests holds to these versions. -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <!--#if (postgreSql)-->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <!--#endif-->
    <!--#if (sqlServer)-->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <!--#endif-->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
  </ItemGroup>

  <!--#endif-->
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!--#if (files)-->
    <!--#if (serverDatabase)-->
    <!-- Keep on the same version as the Testcontainers database module, which pins this core exactly. -->
    <!--#endif-->
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <!--#endif-->
    <!--#if (sqlServer)-->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <!--#endif-->
    <!--#if (postgreSql)-->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <!--#endif-->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
